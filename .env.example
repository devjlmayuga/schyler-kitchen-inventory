# Neon pooled URL for the Next.js runtime. Verify the server certificate.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Neon direct URL for schema migration and XLSX import scripts.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Existing application authentication settings.
SI_API_TOKEN=replace-me
SI_JWT_SECRET=replace-me
SI_AUTH_PEPPER=replace-me
# Separate secret used to encrypt biometric descriptors before storage.
FACE_DESCRIPTOR_KEY=replace-with-a-long-random-secret
